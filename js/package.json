{
  "name": "qroid-qr",
  "version": "0.1.0",
  "description": "Tiny zero-dependency QR code generator — square or round. Static HTML (<qroid-qr>), Node, Browser, React & React Native. From Qroid.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "unpkg": "./dist/qroid-qr.min.js",
  "jsdelivr": "./dist/qroid-qr.min.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./browser": {
      "types": "./src/browser.d.ts",
      "default": "./src/browser.js"
    },
    "./standalone": "./dist/qroid-qr.min.js",
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./react-native": {
      "types": "./src/react-native.d.ts",
      "default": "./src/react-native.js"
    }
  },
  "bin": {
    "qroid-qr": "bin/qroid-qr.js"
  },
  "files": [
    "src",
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-standalone.js",
    "prepack": "node scripts/build-standalone.js",
    "test": "node scripts/build-standalone.js && node --test test/*.test.js"
  },
  "keywords": [
    "qr",
    "qrcode",
    "qroid",
    "svg",
    "png",
    "ascii",
    "web-component",
    "cdn",
    "react",
    "react-native"
  ],
  "author": "Qroid",
  "license": "MIT",
  "homepage": "https://qroid.com/en/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qroid-com/qroid-qr.git",
    "directory": "js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">=17",
    "react-native-svg": ">=13"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  }
}
